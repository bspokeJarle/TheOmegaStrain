<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>RetroMesh.Engine</PackageId>
    <VersionPrefix>0.1.0</VersionPrefix>
    <Title>RetroMesh Engine</Title>
    <Authors>Jarle Adolfsen</Authors>
    <Company>Jatech Game Development</Company>
    <Product>RetroMesh Engine</Product>
    <Description>Reusable retro 3D engine primitives for polygon rendering, geometry, collision, frame timing, input, and audio.</Description>
    <Copyright>Copyright (c) 2026 Jarle Adolfsen / Jatech Game Development</Copyright>
    <PackageTags>retromesh;game-engine;retro-3d;projection;collision;audio;input</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="LICENSE" Pack="true" PackagePath="\" />
    <None Include="SUPPORT.md" Pack="true" PackagePath="docs\" />
  </ItemGroup>
</Project>
