<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <RootNamespace>TheOmegaStrain.Wpf</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>TheOmegaStrain</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>GameGraphics\OmegaStrain.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="GameGraphics\OmegaStrain.ico" />
    <None Include="$(RetroMeshDirect3D11ShaderPath)">
      <Link>Shaders\ProjectedTriangle.hlsl</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <!-- Required at runtime by RetroMesh.Engine (XboxControllerInput). RetroMesh.Engine is
         referenced as a raw DLL, so its NuGet dependencies are not resolved transitively. -->
    <PackageReference Include="SharpDX.DirectInput" Version="4.2.0" />
    <Reference Include="RetroMesh.Engine">
      <HintPath>$(RetroMeshEnginePath)</HintPath>
    </Reference>
    <Reference Include="RetroMesh.Rendering.Direct3D11">
      <HintPath>$(RetroMeshDirect3D11Path)</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TheOmegaStrain.Runtime\TheOmegaStrain.Runtime.csproj" />
    <ProjectReference Include="..\TheOmegaStrain.Game\TheOmegaStrain.Game.csproj" />
    <ProjectReference Include="..\TheOmegaStrain.Steam\TheOmegaStrain.Steam.csproj" />
  </ItemGroup>
